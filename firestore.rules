// Security rules for the crusade-dataslate Firestore database.
// Not deployed automatically: paste into Firebase console → Firestore → Rules → Publish.
// Keep the GM's email in step with src/cloud/config.ts. Players are the GM plus everyone in members/.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email; }
    function isPlayer(e) { return e == 'brestel.jason@gmail.com' || exists(/databases/$(database)/documents/members/$(e)); }
    function player() { return signedIn() && isPlayer(email()); }
    function gm() { return signedIn() && email() == 'brestel.jason@gmail.com'; }
    function own(id) { return signedIn() && id == email(); }

    // Each force is edited only by the player who owns it, who can also hand it to another player.
    match /forces/{id} {
      allow read: if player();
      allow create: if player() && request.resource.data.owner == email();
      allow update: if player() && resource.data.owner == email() && (request.resource.data.owner == email() || isPlayer(request.resource.data.owner));
      allow delete: if player() && resource.data.owner == email();
    }

    // The GM lets people in; anyone signed in can ask to join, and see whether they've been let in.
    match /members/{id} {
      allow read: if player() || own(id);
      allow write: if gm();
    }
    match /requests/{id} {
      allow read: if gm() || own(id);
      allow create, update: if own(id) && request.resource.data.email == email();
      allow delete: if gm() || own(id);
    }

    // Players update the campaign after battles; only the GM starts or ends one.
    match /campaign/{id} {
      allow read: if player();
      allow create, delete: if gm();
      allow update: if gm() || (player() && request.resource.data.id == resource.data.id);
    }

    match /books/{id} { allow read, write: if player(); }
    match /images/{id} { allow read, write: if player(); }
    // Finished battles everyone can look back on and claim their rewards from.
    match /battles/{id} { allow read, write: if player(); }

    // Nexus Wars sealed orders. The GM opens a round and reveals it. Until then each player sees only
    // their own orders, which they can change; everyone sees who has declared. Revealing locks them.
    function round() { return get(/databases/$(database)/documents/orderRound/current).data; }
    function sealing() { return exists(/databases/$(database)/documents/orderRound/current) && round().revealed == false && request.resource.data.round == round().round; }
    match /orderRound/{id} {
      allow read: if player();
      allow write: if gm();
    }
    match /orders/{id} {
      allow read: if own(id) || (player() && round().revealed == true);
      allow create, update: if own(id) && player() && sealing();
    }
    match /declared/{id} {
      allow read: if player();
      allow create, update: if own(id) && player() && sealing();
    }

    // Painting Backlog (candlebird.github.io/painting-backlog): paint progress, keyed by unit id, or "x-…" for models
    // that aren't in a force. Everyone sees the group's progress. Whoever owns the unit's force edits it (so it follows
    // a force that's handed over); other entries only their owner. The Dataslate itself never reads these.
    function forceOwner(d) { return 'forceId' in d && exists(/databases/$(database)/documents/forces/$(d.forceId)) && get(/databases/$(database)/documents/forces/$(d.forceId)).data.owner == email(); }
    function paintEditor(d) { return d.owner == email() || forceOwner(d); }
    match /paint/{id} {
      allow read: if player();
      allow create: if player() && request.resource.data.owner == email() && (!('forceId' in request.resource.data) || forceOwner(request.resource.data));
      allow update: if player() && paintEditor(resource.data) && request.resource.data.owner == email();
      allow delete: if player() && paintEditor(resource.data);
    }
    // One photo per paint entry, written in the same batch as its paint document.
    match /paintPhotos/{id} {
      allow read: if player();
      allow create, update: if player() && request.resource.data.owner == email() && request.resource.data.data.size() < 900000
        && getAfter(/databases/$(database)/documents/paint/$(id)).data.owner == email();
      allow delete: if player() && exists(/databases/$(database)/documents/paint/$(id)) && paintEditor(get(/databases/$(database)/documents/paint/$(id)).data);
    }

    // House rules are the GM's; core rule texts anyone can import.
    match /shared/{id} {
      allow read: if player();
      allow write: if id == 'settings' ? gm() : player();
    }
  }
}
