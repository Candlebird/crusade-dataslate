// Security rules for the crusade-dataslate Firestore database.
// Not deployed automatically: paste into Firebase console → Firestore → Rules → Publish.
// Keep the player list in step with src/cloud/config.ts.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email; }
    function player() { return signedIn() && email() in ['brestel.jason@gmail.com', 'leif.brestel@gmail.com']; }
    function gm() { return signedIn() && email() == 'brestel.jason@gmail.com'; }

    // Each force is edited only by the player who owns it.
    match /forces/{id} {
      allow read: if player();
      allow create: if player() && request.resource.data.owner == email();
      allow update: if player() && resource.data.owner == email() && request.resource.data.owner == email();
      allow delete: if player() && resource.data.owner == email();
    }

    // Players update the campaign after battles; only the GM starts or ends one.
    match /campaign/{id} {
      allow read: if player();
      allow create, delete: if gm();
      allow update: if gm() || (player() && request.resource.data.id == resource.data.id);
    }

    match /books/{id} { allow read, write: if player(); }
    match /images/{id} { allow read, write: if player(); }
    // Finished battles everyone can look back on and claim their rewards from.
    match /battles/{id} { allow read, write: if player(); }

    // House rules are the GM's; core rule texts anyone can import.
    match /shared/{id} {
      allow read: if player();
      allow write: if id == 'settings' ? gm() : player();
    }
  }
}
